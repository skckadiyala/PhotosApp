# PhotosApp Environment Configuration
# Copy this file to .env and fill in the values

# ======================
# Database
# ======================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=photosapp
POSTGRES_USER=photosapp
POSTGRES_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD

# ======================
# Redis
# ======================
REDIS_HOST=redis
REDIS_PORT=6379

# ======================
# Backend
# ======================
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Path to photos on the external drive (inside container)
PHOTOS_DIR=/mnt/photos
# Path to thumbnail cache (inside container)
THUMBNAILS_DIR=/data/thumbnails

# First admin user (created on seed)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@photosapp.dev
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ======================
# Celery (for future phases)
# ======================
CELERY_BROKER_URL=redis://redis:6379/0

# ======================
# External Drive Path (HOST)
# Adjust to your actual photo directory on the host machine
# ======================
# macOS:    /Volumes/MyDrive/Photos
# Linux:    /mnt/photos
# Windows:  /d/Photos (Docker path for D:\Photos)
HOST_PHOTOS_DIR=/mnt/photos
